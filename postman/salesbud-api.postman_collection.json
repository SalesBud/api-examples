    {
      "name": "Meetings",
      "item": [
        {
          "name": "List completed meetings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/meetings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "meetings"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Records per page, 1 to 100. A page may return fewer than this while has_more is still true; drive the loop by has_more, not by the size of data. Max 100.",
                  "disabled": false
                },
                {
                  "key": "cursor",
                  "value": "{{meetings_cursor}}",
                  "description": "Signed cursor returned by the previous page.",
                  "disabled": false
                },
                {
                  "key": "created_after",
                  "value": "2026-01-01T00:00:00Z",
                  "description": "Return records created after this instant.",
                  "disabled": true
                },
                {
                  "key": "created_before",
                  "value": "2026-01-01T00:00:00Z",
                  "description": "Return records created before this instant.",
                  "disabled": true
                },
                {
                  "key": "meeting_after",
                  "value": "2026-01-01T00:00:00Z",
                  "description": "Return records whose event instant is after this value.",
                  "disabled": true
                },
                {
                  "key": "meeting_before",
                  "value": "2026-01-01T00:00:00Z",
                  "description": "Return records whose event instant is before this value.",
                  "disabled": true
                },
                {
                  "key": "owner_email",
                  "value": "owner@example.com",
                  "description": "Exact case-insensitive owner email match.",
                  "disabled": true
                },
                {
                  "key": "type",
                  "value": "video",
                  "description": "Media the record was captured as. Independent of the resource kind: a call can be video and a meeting can be audio. One of: video, audio.",
                  "disabled": true
                },
                {
                  "key": "audience",
                  "value": "internal",
                  "description": "Whether the record had participants from outside the company (external) or only internal ones. One of: internal, external.",
                  "disabled": true
                },
                {
                  "key": "has_transcript",
                  "value": "",
                  "description": "Filter by existence of a transcript resource.",
                  "disabled": true
                }
              ]
            },
            "description": "List completed meetings\n\nRequires the `meetings.read` scope.\n\nSend again to walk to the next page: the response stores `next_cursor` in `meetings_cursor` and the first record's id in `meeting_id`."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// An empty cursor is not a valid cursor: drop the parameter until a page hands one over.",
                  "if (!pm.environment.get(\"meetings_cursor\")) {",
                  "  pm.request.removeQueryParams(\"cursor\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/**",
                  " * Walks the collection by cursor, and remembers one id for the requests below.",
                  " *",
                  " * The loop is driven by `next_cursor`, never by how many records a page returned — a short or even",
                  " * empty page with `has_more: true` is normal, and stopping on it silently truncates the walk. Send",
                  " * this request again to get the next page; the cursor is already in place.",
                  " *",
                  " * Filters must stay identical across the walk: the cursor is signed and binds them.",
                  " */",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const page = pm.response.json();",
                  "  const cursor = page.pagination.next_cursor;",
                  "",
                  "  pm.environment.set(\"meetings_cursor\", cursor || \"\");",
                  "  console.log(",
                  "    cursor",
                  "      ? `Page returned ${page.data.length} meetings, has_more=${page.pagination.has_more}. ` +",
                  "          \"Send again for the next page.\"",
                  "      : `Page returned ${page.data.length} meetings. No cursor: this was the last page.`,",
                  "  );",
                  "",
                  "  const first = page.data[0];",
                  "  if (first) {",
                  "    pm.environment.set(\"meeting_id\", first.id);",
                  "    console.log(`meeting_id set to ${first.id}`);",
                  "  } else if (!pm.environment.get(\"meeting_id\")) {",
                  "    console.log(",
                  "      \"No record on this page. Set meeting_id by hand (it looks like mtg_…) or widen the filters.\",",
                  "    );",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
