{
  "info": {
    "name": "Salesbud API v0.1.0",
    "description": "Every route of the Salesbud API, with the token renewal and the cursor walk already wired up.\n\n**Before the first send:** duplicate the bundled environment, fill in `client_id` and `client_secret`, and select it. The collection issues and renews the token by itself — there is no \"get token\" step to remember.\n\nCredentials are issued by Salesbud for your company; they are not self-service. The secret is shown once, at creation.\n\nFull reference: https://docs.salesbud.com.br",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/**",
          " * Issues and renews the access token, so every request below just works.",
          " *",
          " * Client credentials has no refresh token — renewal is asking for a new one. Renewing on a timer",
          " * alone is not enough, so the test script also clears the token on a 401 and the next send reissues.",
          " */",
          "",
          "const RENEW_MARGIN_MS = 60 * 1000;",
          "",
          "const rawUrl = pm.request.url.toString();",
          "const needsToken = !rawUrl.includes(\"/oauth/token\") && !rawUrl.includes(\"/health/\");",
          "",
          "function fresh() {",
          "  const token = pm.environment.get(\"access_token\");",
          "  const expiresAt = Number(pm.environment.get(\"token_expires_at\")) || 0;",
          "  return Boolean(token) && Date.now() + RENEW_MARGIN_MS < expiresAt;",
          "}",
          "",
          "if (needsToken && !fresh()) {",
          "  const environmentSelected = Object.keys(pm.environment.toObject()).length > 0;",
          "  if (!environmentSelected) {",
          "    throw new Error(",
          "      \"Select the Salesbud environment first — it holds the credential and the issued token.\",",
          "    );",
          "  }",
          "",
          "  const clientId = pm.environment.get(\"client_id\");",
          "  const clientSecret = pm.environment.get(\"client_secret\");",
          "  if (!clientId || !clientSecret) {",
          "    throw new Error(",
          "      \"Set client_id and client_secret in the environment. Credentials are issued by Salesbud; \" +",
          "        \"they are not self-service.\",",
          "    );",
          "  }",
          "",
          "  pm.sendRequest(",
          "    {",
          "      url: `${pm.variables.replaceIn(\"{{base_url}}\")}/oauth/token`,",
          "      method: \"POST\",",
          "      header: { \"Content-Type\": \"application/x-www-form-urlencoded\" },",
          "      body: {",
          "        mode: \"urlencoded\",",
          "        urlencoded: [",
          "          { key: \"grant_type\", value: \"client_credentials\" },",
          "          { key: \"client_id\", value: clientId },",
          "          { key: \"client_secret\", value: clientSecret },",
          "        ],",
          "      },",
          "    },",
          "    (error, response) => {",
          "      if (error) throw error;",
          "",
          "      const body = response.json();",
          "      if (response.code !== 200) {",
          "        throw new Error(",
          "          `Token request failed (${response.code}): ${body.error_description || body.error}`,",
          "        );",
          "      }",
          "",
          "      pm.environment.set(\"access_token\", body.access_token);",
          "      pm.environment.set(\"token_expires_at\", String(Date.now() + body.expires_in * 1000));",
          "      console.log(`Token issued, valid for ${body.expires_in}s. Scopes: ${body.scope}`);",
          "    },",
          "  );",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/**",
          " * Reports what you need to act on, and nothing else.",
          " *",
          " * Branch on `error.code`, never on `detail` — the code is stable across releases, the text is not.",
          " * Every error carries a `request_id`; quote it when contacting support.",
          " */",
          "",
          "if (pm.response.code === 401) {",
          "  // The credential may have been revoked, or the token rotated out, before it expired.",
          "  pm.environment.unset(\"access_token\");",
          "  pm.environment.set(\"token_expires_at\", \"0\");",
          "}",
          "",
          "pm.test(`${pm.response.code} ${pm.response.status}`, () => {",
          "  if (pm.response.code < 400) return;",
          "",
          "  const body = pm.response.json();",
          "  const error = body.error || {};",
          "  const retryAfter = pm.response.headers.get(\"Retry-After\");",
          "",
          "  const parts = [error.code || body.error, error.detail || body.error_description];",
          "  if (error.request_id) parts.push(`request_id=${error.request_id}`);",
          "  if (retryAfter) parts.push(`Retry-After=${retryAfter}s`);",
          "",
          "  pm.expect.fail(parts.filter(Boolean).join(\" | \"));",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.salesbud.com.br",
      "type": "string",
      "description": "Overridden by the environment. Defaults to production."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Issue an access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/oauth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "oauth",
                "token"
              ]
            },
            "description": "Issue an access token\n\nNo credential required.\n\nYou do not need to send this: every other request renews on its own. It is here to read back the scopes and lifetime a credential got.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "scope",
                  "value": "",
                  "description": "Optional. Omit to receive every scope the credential carries.",
                  "disabled": true
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/**",
                  " * The one request that shows you the token instead of using it.",
                  " *",
                  " * Every other request renews on its own through the collection's pre-request script, so you never",
                  " * need to send this one — it is here to inspect the scopes and lifetime a credential actually got.",
                  " */",
                  "",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set(\"access_token\", body.access_token);",
                  "  pm.environment.set(\"token_expires_at\", String(Date.now() + body.expires_in * 1000));",
                  "",
                  "  pm.test(\"granted the scopes the credential carries\", () => {",
                  "    pm.expect(body.token_type).to.eql(\"Bearer\");",
                  "    pm.expect(body.scope).to.be.a(\"string\");",
                  "  });",
                  "",
                  "  console.log(`Scopes: ${body.scope}`);",
                  "  console.log(`Expires in: ${body.expires_in}s`);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
